{
    "name": "alkinbg/masked-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle for automatic sensitive data detection and masking.",
    "keywords": [
        "symfony",
        "security",
        "masking",
        "redaction",
        "sensitive-data",
        "credit-card"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Alkin Fehim"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "psr/log": "^1|^2|^3",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-kernel": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "monolog/monolog": "^3.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "symfony/monolog-bundle": "^4.0"
    },
    "suggest": {
        "monolog/monolog": "Required to use the Monolog processor and formatter integrations.",
        "symfony/monolog-bundle": "Required for automatic processor registration in Symfony applications."
    },
    "autoload": {
        "psr-4": {
            "Alkin\\MaskedBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alkin\\MaskedBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "format:check": "php-cs-fixer check --diff --config=.php-cs-fixer.dist.php",
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
